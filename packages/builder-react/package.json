{
  "name": "@payload-toolkit/builder-react",
  "version": "0.1.0",
  "description": "Default React components and the layout renderer for @payload-toolkit/builder: RenderLayout, loadLayoutData and the canvas iframe runtime.",
  "keywords": [
    "payload",
    "payloadcms",
    "page-builder",
    "website-builder",
    "react",
    "react-server-components",
    "tailwindcss",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Eugene Lominos <hello@eugenelominos.com>",
  "homepage": "https://github.com/jon8800/payload-toolkit/tree/main/packages/builder-react#readme",
  "bugs": "https://github.com/jon8800/payload-toolkit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jon8800/payload-toolkit.git",
    "directory": "packages/builder-react"
  },
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./server": "./src/server.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas/index.d.ts",
        "default": "./dist/canvas/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "@payload-toolkit/builder": "^0.1.0",
    "@payloadcms/richtext-lexical": "^3.90.0",
    "payload": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@payload-toolkit/builder": "workspace:*",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.3.8",
    "oxlint": "^1.86.0",
    "payload": "^3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@lexical/history": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/utils": "0.50.0",
    "lexical": "0.50.0",
    "motion": "^14.0.0"
  }
}
