{
  "name": "payload-canvas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "pack:packages": "pnpm --filter ./packages/payload-canvas --filter ./packages/create-payload-canvas exec pnpm pack --pack-destination ../../dist-packages",
    "release:dry": "node -e \"require('node:fs').rmSync('dist-packages',{recursive:true,force:true})\" && pnpm pack:packages && node scripts/publish.mjs --dry-run dist-packages"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "@babel/core": "7.29.7",
    "babel-plugin-macros": "3.1.0"
  },
  "packageManager": "pnpm@10.34.6"
}
