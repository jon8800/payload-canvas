# === Database ===
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/payload_starter

# === Payload ===
# Secret key for Payload authentication (change in production)
PAYLOAD_SECRET=your-secret-key-change-in-production

# DEV ONLY: the admin opens signed in as this user, with no login form (admin.autoLogin).
# Ignored unless NODE_ENV is development. Empty = the normal login form.
# The email of a user that already exists, for example the first admin you created.
# To sign in as another user, leave this empty and restart the dev server.
DEV_AUTOLOGIN_EMAIL=

# Public URL of the server (used for SEO, redirects, and the preview links the MCP tools return)
# MCP: AI agents connect to POST <this URL>/api/mcp. Two ways in, see docs/ai/connect-claude-code-and-codex.md:
#   - Sign in with the admin login (OAuth). The client needs only the URL. This value is the sign-in issuer,
#     so it must match the address you open (a dev server on port 3300 needs http://localhost:3300 here).
#   - An API key from Admin > MCP > API Keys.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional: only these admin emails may sign in to MCP with OAuth (comma-separated). Empty = every admin user.
# MCP_OAUTH_ALLOWED_EMAILS=you@example.com

# @feature:ai
# === AI assistant (editor) ===
# Guide: docs/ai/providers.md. Restart the server after changes.
# No API key? Use Claude Code or Codex with your Claude / ChatGPT plan instead:
# docs/ai/connect-claude-code-and-codex.md (they connect over MCP, see NEXT_PUBLIC_SERVER_URL above).
#
# The adapter is picked in src/payload.config.ts (the `ai` option of websiteBuilder). The starter
# reads the variables below. For Anthropic, Cloudflare or any OpenAI-compatible API, change the
# adapter there: docs/ai/providers.md shows each one.
#
# OpenRouter key (https://openrouter.ai/keys). Set: the assistant uses OpenRouter. Empty: setup card.
OPENROUTER_API_KEY=
# OpenRouter model id. Default: openai/gpt-6-luna.
# OPENROUTER_MODEL=google/gemini-3.8-flash
#
# Image generation uses the same OpenRouter key with an image model (docs/ai/images.md).
# Default: black-forest-labs/flux.2-klein-4b (photo-real, about 1 US cent per image).
# Cheaper design-style option: recraft/recraft-v4.1-flash. Limits: 3 images per assistant reply,
# 20 per user per hour (ai.imageLimits in src/payload.config.ts).
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
#
# DEV ONLY: BUILDER_AI_FAKE=1 answers with a scripted model (no key, no cost, no network).
# Without OPENROUTER_API_KEY it also draws local gradient images for "Generate image".
# Ignored in production.
# BUILDER_AI_FAKE=1
# @end:ai

# @feature:dashboard
# === Dashboard analytics (optional) ===
# The dashboard's Analytics widget shows visitors from Plausible or Umami. Not set: it stays off.
# Plausible: an API key (Settings > API keys) and the site's domain.
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=example.com
# Only for a self-hosted Plausible:
# PLAUSIBLE_URL=https://plausible.example.com
# Umami Cloud: an API key and the website id. Self-hosted: an API token and your server's API address.
# UMAMI_API_KEY=
# UMAMI_WEBSITE_ID=
# UMAMI_URL=https://umami.example.com/api
# @end:dashboard

# @feature:reviews
# === Google reviews (payload-google-reviews) ===
# Pick the source, the Place ID or the Maps URL in Admin > Settings > Review Settings.
# The Places API source (up to 5 reviews) needs a Google Cloud key with the Places API (New) on.
# The Scraper source (every public review) needs no key.
# GOOGLE_PLACES_API_KEY=
# @end:reviews


# === SMTP Email (optional - for form notifications) ===
# Works with any SMTP provider (AWS SES, SendGrid, Mailgun, etc.)
# Uncomment and fill in to enable email sending
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=false

# Fallback recipient for form submission notifications (used when no email is configured on the form)
# ADMIN_EMAIL=admin@yourdomain.com
