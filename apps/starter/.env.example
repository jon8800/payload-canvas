# === Database ===
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/payload_starter

# === Payload ===
# Secret key for Payload authentication (change in production)
PAYLOAD_SECRET=your-secret-key-change-in-production

# Public URL of the server (used for SEO, redirects, and the preview links the MCP tools return)
# MCP: AI agents connect to POST <this URL>/api/mcp with a key from Admin > MCP > API Keys. No extra env vars.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# === AI assistant (editor) ===
# Guide: docs/ai/providers.md. Restart the server after changes.
# No API key? Use Claude Code or Codex with your Claude / ChatGPT plan instead:
# docs/ai/connect-claude-code-and-codex.md (they connect over MCP, see NEXT_PUBLIC_SERVER_URL above).
#
# Easiest: an OpenRouter key alone turns the assistant on (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
#
# Provider: anthropic | openrouter | cloudflare | openai-compatible.
# Default: openrouter when only OPENROUTER_API_KEY is set, else anthropic.
# BUILDER_AI_PROVIDER=openrouter
# Model id in the provider's naming. OpenRouter default: openai/gpt-6-luna.
# BUILDER_AI_MODEL=google/gemini-3.8-flash
#
# Anthropic (BUILDER_AI_PROVIDER=anthropic): key from https://console.anthropic.com,
# or run `ant auth login` on the server and leave it empty.
ANTHROPIC_API_KEY=
#
# Cloudflare AI Gateway (BUILDER_AI_PROVIDER=cloudflare, BUILDER_AI_MODEL=openai/gpt-5.2 or similar):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_ID=
# Gateway token (cf-aig-authorization), for authenticated gateways, stored keys or unified billing:
# CF_AIG_TOKEN=
#
# Any OpenAI-compatible API (BUILDER_AI_PROVIDER=openai-compatible), e.g. OpenAI, Groq, Ollama:
# BUILDER_AI_BASE_URL=https://api.openai.com/v1
# Key for openai-compatible, or the provider key behind Cloudflare. Leave empty for Ollama / LM Studio.
# BUILDER_AI_API_KEY=
#
# TEST ONLY: BUILDER_AI_FAKE=1 answers with a scripted model (no key, no cost, no network) for any
# provider. Ignored in production.
# BUILDER_AI_FAKE=1


# === SMTP Email (optional - for form notifications) ===
# Works with any SMTP provider (AWS SES, SendGrid, Mailgun, etc.)
# Uncomment and fill in to enable email sending
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=false

# Fallback recipient for form submission notifications (used when no email is configured on the form)
# ADMIN_EMAIL=admin@yourdomain.com
